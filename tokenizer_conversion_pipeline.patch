+std::string BuildDiscoveryChecksum(const std::vector<DiscoveredFile>& discovered)
+{
+    std::ostringstream stream;
+    for (const DiscoveredFile& file : discovered)
+    {
+        stream << file.relativePath << '\t' << file.inputBytes << '\n';
