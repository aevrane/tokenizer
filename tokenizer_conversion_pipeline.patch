+    stream << "  \"ordered_files_path\": " << QuoteJson(progress.orderedFilesPath) << ",\n";
+    stream << "  \"discovery_checksum\": " << QuoteJson(progress.discoveryChecksum) << ",\n";
+    stream << "  \"start_time_utc\": " << QuoteJson(progress.startTimeUtc) << ",\n";
